# Drizzle / Turso
#
# LOCAL DEV: talk to the DB over a libsql URL (served by `turso dev`), like prod —
# not a raw file, so nothing double-writes the SQLite file. `pnpm dev:local` /
# `pnpm dev:db` start sqld on this port; the Conductor run injects it per-workspace.
DATABASE_URL="http://127.0.0.1:8081"
# Offline escape hatch for one-off scripts with no sqld running: DATABASE_URL="file:local.db"
#
# PRODUCTION: point at remote Turso and set the auth token.
# DATABASE_URL="libsql://db-name-user.turso.io"
# An auth token is required for remote (libsql:// / https://) URLs only.
DATABASE_AUTH_TOKEN=""

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters generated with high entropy.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="dev-secret-change-me"

# The bearer Vercel Cron presents to /api/cron/sweep-submissions (the daily
# sweep). Production only: set a random string of at least 16 characters in
# Vercel → Settings → Environment Variables. Unset, the endpoint refuses every
# caller. To run the sweep locally, set any value here and send it yourself:
#   curl -H "Authorization: Bearer <value>" http://localhost:5173/api/cron/sweep-submissions
CRON_SECRET=""

# Resend (OTP email delivery). When unset, one-time codes are logged to the
# server console instead — fine for local dev.
RESEND_API_KEY=""
# Verified sender, e.g. "TAG Archive <archive@yourdomain.org>".
# Falls back to onboarding@resend.dev (delivers only to the Resend account
# owner's email until a domain is verified).
RESEND_FROM=""

# Scan storage (S3-compatible). These defaults target the LOCAL RustFS container
# that `pnpm dev:local` starts — copy this file to .env and they just work.
# `S3_ENDPOINT` + `R2_PUBLIC_URL` are injected by the run scripts (per-workspace
# ports), so they're intentionally left unset here.
R2_ACCESS_KEY_ID="rustfsadmin"
R2_SECRET_ACCESS_KEY="rustfsadmin"
R2_BUCKET="tag-archive"
S3_REGION="auto"
#
# PRODUCTION uses Cloudflare R2 instead — do NOT put prod keys here. Set these in
# Vercel → Settings → Environment Variables (and .env.production for `vite preview`):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_URL
# R2_PUBLIC_URL must reach builds as well: it is the one host the image
# optimizer may fetch from (svelte.config.js), and a Vercel build fails without it.
# Create an R2 bucket, enable its Public Development URL, and mint an
# "Object Read & Write" API token (account id is in the S3 endpoint host).

# Photograph uploads go from the browser straight to the bucket (presigned PUTs),
# so the bucket must allow the page's origin by CORS (see README → Photographs).
#
# LOCAL DEV ONLY: set to "1" to route the browser's uploads through the app
# (/api/images/put) instead — for when the local store refuses the CORS preflight
# (scripts/init-bucket.mjs warns at boot if it couldn't set the rule), or for a
# phone on the LAN or a tunnel, which can't reach the store's 127.0.0.1 address.
# Ignored outside `vite dev` and whenever S3_ENDPOINT is unset (remote R2).
# S3_UPLOAD_PROXY="1"
#
# PRODUCTION: the R2 bucket's CORS rule is applied from your machine with
# `pnpm storage:cors` (scripts/r2-cors.mjs, via wrangler; needs a Cloudflare login
# or CLOUDFLARE_API_TOKEN). It reads R2_BUCKET and R2_CORS_ORIGINS from the
# shell only, never from this file, whose values are the dev site's:
#   R2_BUCKET="<prod bucket>" R2_CORS_ORIGINS="https://archive.ustreetcommunity.org" \
#     pnpm storage:cors
# R2_CORS_ORIGINS lists exactly the origins allowed to upload: comma-separated,
# scheme + host (+ port), no trailing slash, no wildcards. When unset, an
# exported ORIGIN stands in (never the ORIGIN above, nor a local address).
# R2 can't wildcard subdomains, so a Vercel preview deployment can only upload
# once its own origin is listed.

# NFC access tag (NTAG 424 DNA) — the garden tag whose taps open the site, for as
# long as it stays on screen plus 20 minutes (see README → Access). Two AES-128
# keys, 32 hex characters each:
# the SAME values are written onto the tag. PRODUCTION REQUIRES BOTH, and
# refuses the all-zero factory default — generate each with `openssl rand -hex 16`
# and set them in Vercel → Settings → Environment Variables.
#
# These zero keys (NXP's app-note test keys) are fine for local dev:
# `pnpm nfc:tap` mints a tap URL signed with them.
NFC_SDM_META_KEY="00000000000000000000000000000000"
NFC_SDM_FILE_KEY="00000000000000000000000000000000"
