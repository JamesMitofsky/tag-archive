{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"skipMiddlewareRequestBody": true,
	"crons": [
		{
			"path": "/api/cron/sweep-submissions",
			"schedule": "0 0 * * *"
		}
	],
	"headers": [
		{
			"source": "/audio/meditation-walk/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow, noarchive"
				}
			]
		}
	],
	"git": {
		"deploymentEnabled": {
			"main": true,
			"**": false
		}
	}
}
