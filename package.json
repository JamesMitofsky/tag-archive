{
	"name": "bangui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:local": "bash scripts/dev-local.sh",
		"dev:fresh-start": "pnpm db:setup:local && pnpm dev:local",
		"dev:db": "turso dev --db-file local.db --port 8081",
		"dev:storage": "docker rm -f tag-archive-rustfs >/dev/null 2>&1; docker run --rm --name tag-archive-rustfs -p 9000:9000 -e RUSTFS_ACCESS_KEY=rustfsadmin -e RUSTFS_SECRET_KEY=rustfsadmin -e RUSTFS_ADDRESS=:9000 rustfs/rustfs:latest /data",
		"dev:storage:init": "S3_ENDPOINT=http://127.0.0.1:9000 R2_PUBLIC_URL=http://127.0.0.1:9000/tag-archive node --env-file-if-exists=.env scripts/init-bucket.mjs",
		"storage:cors": "node scripts/r2-cors.mjs",
		"db:seed:images": "S3_ENDPOINT=http://127.0.0.1:9000 R2_PUBLIC_URL=http://127.0.0.1:9000/tag-archive DATABASE_URL=http://127.0.0.1:8081 node --env-file-if-exists=.env scripts/seed-images.mjs",
		"db:seed:photographs": "S3_ENDPOINT=http://127.0.0.1:9000 R2_PUBLIC_URL=http://127.0.0.1:9000/tag-archive DATABASE_URL=http://127.0.0.1:8081 node --env-file-if-exists=.env scripts/seed-photographs.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && husky || echo ''",
		"prettier": "prettier --check .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/lib/server/db/migrate.ts",
		"db:migrate:test": "bash scripts/migrate-test.sh",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:setup:local": "bash scripts/db-setup.sh",
		"events:fetch": "tsx src/lib/server/events-import/fetch.ts",
		"events:curate": "tsx src/lib/server/events-import/curate.ts",
		"events:import": "tsx src/lib/server/events-import/import.ts",
		"events:restore": "tsx src/lib/server/events-import/restore.ts",
		"nfc:tap": "tsx --env-file-if-exists=.env scripts/nfc-tap-url.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^1.10.0",
		"@chromatic-com/storybook": "^5.6.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.18.0",
		"@playwright/test": "^1.65.1",
		"@storybook/addon-a11y": "10.6.7",
		"@storybook/addon-docs": "10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "10.6.7",
		"@storybook/sveltekit": "10.6.7",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"auth": "~1.7.25",
		"better-auth": "~1.7.25",
		"bits-ui": "^2.21.0",
		"concurrently": "^10.0.7",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"entities": "^8.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "10.6.7",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"htmlparser2": "^12.0.0",
		"husky": "^9.1.7",
		"mdsvex": "^0.12.8",
		"phosphor-svelte": "^3.1.1",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "10.6.7",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.2.1",
		"wrangler": "^4.164.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@fontsource-variable/nunito": "^5.3.0",
		"@jsquash/webp": "^1.5.0",
		"@lucide/svelte": "^1.75.0",
		"@tanstack/svelte-virtual": "3.13.52",
		"@vercel/functions": "^3.11.3",
		"aws4fetch": "^1.0.20",
		"clsx": "^2.1.1",
		"exifr": "7.1.3",
		"heic-to": "^1.6.7",
		"scanic": "^1.8.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"vest": "^6.3.4"
	}
}
